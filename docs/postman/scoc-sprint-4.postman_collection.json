              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('devolve token e usuário sem hash', () => { pm.expect(r.token).to.be.a('string'); pm.expect(r.usuario).to.not.have.property('senhaHash'); });",
                  "pm.test('token vale oito horas', () => { const exp = JSON.parse(atob(r.token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/'))); pm.expect(exp.exp - exp.iat).to.eql(8 * 3600); });",
                  "pm.collectionVariables.set('token', r.token);"
                ]
              }
            }
