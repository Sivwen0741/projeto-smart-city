# Copie para .env (cp .env.example .env) e troque os valores. O .env não é versionado.

# Banco PostgreSQL/PostGIS
DB_NAME=scoc
DB_USER=scoc
DB_PASSWORD=troque-esta-senha

# Portas publicadas no localhost (opcional; altere se já estiverem em uso)
# DB_PORTA_LOCAL=5432
# MQTT_PORTA_LOCAL=1883
# API_PORTA_LOCAL=3000
# WEB_PORTA_LOCAL=8080
