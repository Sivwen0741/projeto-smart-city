# copie para .env e troque os valores

DB_NAME=scoc
DB_USER=scoc
DB_PASSWORD=troque-esta-senha

# segredo de assinatura dos tokens, mínimo de 32 caracteres (gere com: openssl rand -hex 32)
JWT_SEGREDO=troque-por-um-segredo-aleatorio-de-32-caracteres-ou-mais

# usuário administrador criado na primeira subida, se o e-mail ainda não existir
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@pontagrossa.pr.gov.br
ADMIN_SENHA=troque-esta-senha

# portas no localhost, opcionais
# DB_PORTA_LOCAL=5432
# MQTT_PORTA_LOCAL=1883
# API_PORTA_LOCAL=3000
# WEB_PORTA_LOCAL=8080

# rotinas agendadas, opcionais; zero desliga
# VERIFICACAO_COMUNICACAO_SEGUNDOS=60
# OPEN_METEO_INTERVALO_MINUTOS=60
